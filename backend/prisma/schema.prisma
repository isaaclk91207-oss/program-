generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Models ──────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  password     String
  name         String
  role         String   // ADMIN | DRIVER | PASSENGER
  phone        String?
  avatarUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  driverProfile    DriverProfile?
  passengerProfile PassengerProfile?

  @@map("users")
}

model DriverProfile {
  userId           String  @id
  certLevel        String  @default("CD")       // CD | CC | CPC | CEC | CMC
  certStatus       String  @default("PENDING")   // PENDING | CERTIFIED | SUSPENDED | REVOKED
  validUntil       DateTime?
  licenseNo        String?
  joinedDate       DateTime @default(now())
  accidentFree     String?
  englishLevel     String?
  credits          Int     @default(0)
  currentVehicleId String?
  status           String  @default("Active")

  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentVehicle    Vehicle?          @relation(fields: [currentVehicleId], references: [id])
  assessments       Assessment[]
  feedbackRecords   Feedback[]
  vehicleCheckins   VehicleCheckin[]
  transportRequests TransportRequest[]

  @@map("driver_profiles")
}

model PassengerProfile {
  userId     String  @id
  department String

  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  transportRequests TransportRequest[]
  feedbacks         Feedback[]

  @@map("passenger_profiles")
}

model Vehicle {
  id          String  @id @default(uuid())
  plate       String  @unique
  qrValue     String  @unique
  make        String
  model       String
  year        Int
  color       String
  status      String  @default("ACTIVE") // ACTIVE | MAINTENANCE | RETIRED
  gpsDeviceId Int?    @unique // Wialon avl_unit id (e.g. 3366)

  driverProfiles    DriverProfile[]
  transportRequests TransportRequest[]
  feedbackRecords   Feedback[]
  vehicleCheckins   VehicleCheckin[]
  gpsPositions      GpsPosition[]

  @@map("vehicles")
}

model TransportRequest {
  id             String    @id @default(uuid())
  passengerId    String
  driverId       String?
  vehicleId      String?
  status         String    @default("PENDING") // PENDING | ASSIGNED | QR_PENDING | PICK_UP_SCANNED | IN_PROGRESS | DROP_OFF_SCANNED | FEEDBACK_SUBMITTED
  pickup         String
  destination    String
  date           DateTime
  time           String
  pickedUpAt     DateTime?
  droppedOffAt   DateTime?
  noOfPeople     Int       @default(1)
  wayUsers       String?
  section        String?
  serviceType    String?
  purpose        String?
  returnTime     String?
  note           String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  passenger      PassengerProfile @relation(fields: [passengerId], references: [userId])
  driver         DriverProfile?   @relation(fields: [driverId], references: [userId])
  vehicle        Vehicle?         @relation(fields: [vehicleId], references: [id])
  feedback       Feedback?
  notifications  Notification[]
  vehicleCheckins VehicleCheckin[]

  @@map("transport_requests")
}

model Assessment {
  id           String   @id @default(uuid())
  driverId     String
  written      Float    @default(0)
  practical    String   @default("{}")
  operational  String   @default("{}")
  feedbackAvg  Float    @default(0)
  overallScore Float    @default(0)
  certLevel    String   @default("CD") // CD | CC | CPC | CEC | CMC
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  driver DriverProfile @relation(fields: [driverId], references: [userId], onDelete: Cascade)

  @@map("assessments")
}

model Feedback {
  id          String @id @default(uuid())
  requestId   String @unique
  passengerId String
  driverId    String
  vehicleId   String
  rating      Int
  comment     String
  tags        String   @default("[]")
  createdAt   DateTime @default(now())

  transportRequest TransportRequest @relation(fields: [requestId], references: [id])
  passenger        PassengerProfile @relation(fields: [passengerId], references: [userId])
  driver           DriverProfile    @relation(fields: [driverId], references: [userId])
  vehicle          Vehicle          @relation(fields: [vehicleId], references: [id])

  @@map("feedbacks")
}

model VehicleCheckin {
  id               String    @id @default(uuid())
  vehicleId        String
  driverId         String
  requestId        String
  checkInLocation  String?
  checkInTime      DateTime?
  checkInRemark    String?
  checkOutLocation String?
  checkOutTime     DateTime?
  checkOutRemark   String?
  status           String    @default("CHECKED_IN") // CHECKED_IN | CHECKED_OUT
  createdAt        DateTime  @default(now())

  vehicle          Vehicle          @relation(fields: [vehicleId], references: [id])
  driver           DriverProfile    @relation(fields: [driverId], references: [userId])
  transportRequest TransportRequest @relation(fields: [requestId], references: [id])

  @@map("vehicle_checkins")
}

model Notification {
  id               String   @id @default(uuid())
  recipientId      String
  recipientRole    String
  title            String
  message          String
  read             Boolean  @default(false)
  relatedRequestId String?
  createdAt        DateTime @default(now())

  transportRequest TransportRequest? @relation(fields: [relatedRequestId], references: [id])

  @@map("notifications")
}

model SystemSettings {
  id               String @id @default("singleton")
  writtenWeight     Float  @default(0.2)
  practicalWeight   Float  @default(0.3)
  operationalWeight Float  @default(0.3)
  feedbackWeight    Float  @default(0.2)
  passMarks         String @default("{\"CD\":75,\"CC\":80,\"CPC\":85,\"CEC\":88,\"CMC\":90}")
  updatedAt         DateTime @updatedAt

  @@map("system_settings")
}

model GpsPosition {
  id        String   @id @default(uuid())
  vehicleId String
  plate     String
  latitude  Float
  longitude Float
  speed     Float
  course    Float
  timestamp DateTime
  createdAt DateTime @default(now())

  vehicle Vehicle @relation(fields: [vehicleId], references: [id])

  @@index([vehicleId, timestamp])
  @@map("gps_positions")
}
